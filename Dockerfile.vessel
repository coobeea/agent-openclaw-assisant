# Vessel OpenClaw Runtime
# 从参考项目完整复制 OpenClaw

FROM node:22

WORKDIR /app

# 复制完整的 OpenClaw（包含 node_modules）
COPY workspace/source/openclaw/dist ./dist
COPY workspace/source/openclaw/node_modules ./node_modules
COPY workspace/source/openclaw/openclaw.mjs ./
COPY workspace/source/openclaw/package.json ./

# 设置环境变量
ENV NODE_ENV=production \
    OPENCLAW_CONFIG_DIR=/root/.openclaw

# 创建必要的目录
RUN mkdir -p /root/.openclaw /workspace /data/agents

# 暴露端口
EXPOSE 18789

# 健康检查
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:18789/health || exit 1

# 启动命令
CMD ["/bin/sh", "-c", "\
  if [ -f /workspace/config.json ]; then \
    echo '✅ 发现 /workspace/config.json，复制到 OpenClaw 配置目录'; \
    mkdir -p /root/.openclaw; \
    cp /workspace/config.json /root/.openclaw/openclaw.json; \
  fi && \
  echo '🚀 启动 OpenClaw Gateway...' && \
  node openclaw.mjs gateway --allow-unconfigured \
"]
