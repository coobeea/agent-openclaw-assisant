# 简单版 Dockerfile - 使用预编译的二进制文件
FROM alpine:latest

# 设置时区
ENV TZ=Asia/Shanghai

# 创建非 root 用户
RUN addgroup -g 1000 scheduler && \
    adduser -D -u 1000 -G scheduler scheduler

# 设置工作目录
WORKDIR /app

# 复制预编译的二进制文件
COPY bin/scheduler-linux ./scheduler

# 更改所有权和权限
RUN chown scheduler:scheduler /app/scheduler && \
    chmod +x /app/scheduler

# 切换到非 root 用户
USER scheduler

# 暴露端口
EXPOSE 8080

# 启动服务
CMD ["./scheduler"]
