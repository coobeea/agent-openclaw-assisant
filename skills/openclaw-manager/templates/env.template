# OpenClaw 实例环境变量模板
# 复制此文件到实例工作空间并重命名为 .env

# 实例基础配置
OPENCLAW_INSTANCE_ID=openclaw-prod-01
OPENCLAW_PORT=3000
OPENCLAW_LOG_LEVEL=info

# AI 模型配置（示例）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# 数据库配置（如需要）
# DATABASE_URL=postgresql://user:pass@localhost:5432/openclaw

# Redis 配置（如需要）
# REDIS_URL=redis://localhost:6379/0

# 其他配置
# OPENCLAW_TIMEZONE=Asia/Shanghai
# OPENCLAW_LANGUAGE=zh-CN
