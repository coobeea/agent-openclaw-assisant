{
  "$schema": "https://openclaw.app/schema/config.json",
  "meta": {
    "lastTouchedVersion": "2026.3.11",
    "lastTouchedAt": "2026-03-12T00:00:00.000Z"
  },
  "models": {
    "providers": {
      "bailian": {
        "baseUrl": "https://coding.dashscope.aliyuncs.com/v1",
        "apiKey": "你的百炼API-Key",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.5-plus",
            "name": "通义千问 3.5 Plus (推荐)",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "qwen3-coder-plus",
            "name": "通义千问编程版",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 65536
          },
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5 (长上下文)",
            "reasoning": false,
            "input": ["text", "image"],
            "contextWindow": 262144,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "bailian/qwen3.5-plus"
      },
      "models": {
        "bailian/qwen3.5-plus": {},
        "bailian/qwen3-coder-plus": {
          "alias": "coder"
        },
        "bailian/kimi-k2.5": {
          "alias": "kimi"
        }
      },
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 3000,
    "auth": {
      "mode": "none"
    },
    "controlUi": {
      "enabled": true,
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "channels": {
    "feishu": {
      "appId": "你的飞书AppID",
      "appSecret": "你的飞书AppSecret",
      "enabled": true,
      "streaming": false,
      "dmPolicy": "open",
      "groupPolicy": "open"
    }
  },
  "plugins": {
    "entries": {
      "feishu": {
        "enabled": true
      }
    }
  }
}
